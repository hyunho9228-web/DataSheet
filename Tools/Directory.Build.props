<Project>
  <PropertyGroup>
    <DataSheetBuildRoot Condition="'$(DataSheetBuildRoot)' == ''">$(TEMP)\HumanGhostDataTools\Build</DataSheetBuildRoot>
    <BaseIntermediateOutputPath>$(DataSheetBuildRoot)\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(DataSheetBuildRoot)\$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
